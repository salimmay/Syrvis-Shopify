<div class="page-width empty-state">
  <span class="logo" style="font-size: 1.5rem"><span class="logo-mark" aria-hidden="true"></span>{{ shop.name }}</span>
  <h1 class="h1">{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'newsletter__form', style: 'max-width: 440px; width: 100%' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}
      <p class="form-status form-status--success">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
      <input class="input" id="PasswordEmail" type="email" name="contact[email]" required placeholder="{{ 'newsletter.placeholder' | t }}" style="color: var(--ink); background: var(--surface); border-color: var(--hairline-strong)">
      <button type="submit" class="btn btn--primary">{{ 'password.notify' | t }}</button>
    {%- endif -%}
  {%- endform -%}
  <details style="margin-top: 32px">
    <summary class="link-arrow" style="cursor:pointer">{{ 'password.owner' | t }}</summary>
    {%- form 'storefront_password', style: 'display:flex;gap:8px;margin-top:16px' -%}
      <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
      <input class="input" id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
      <button type="submit" class="btn btn--dark">{{ 'password.enter' | t }}</button>
      {%- if form.errors -%}<p class="form-status form-status--error">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" } ]
}
{% endschema %}

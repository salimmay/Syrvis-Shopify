<div class="page-width">
  <h1 class="h1" style="padding-block: clamp(32px, 5vw, 56px) 24px">{{ section.settings.heading | default: page_title }}</h1>
  <div class="collection-tiles" style="--cols: 3">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        <a class="collection-tile" href="{{ collection.url }}">
          <div class="media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 50vw', widths: '300, 450, 600, 900', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="collection-tile__title">{{ collection.title }} <span class="muted">{{ collection.products_count }}</span></span>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list page",
  "class": "section section--flush-top",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "All categories" } ]
}
{% endschema %}

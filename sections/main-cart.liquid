<div class="page-width" data-cart-page data-section-id="{{ section.id }}">
  <h1 class="h1" style="padding-block: clamp(32px, 5vw, 56px) 24px">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    <div class="cart-page">
      <div>
        <p class="form-status form-status--error small" data-cart-error hidden></p>
        <ul class="cart-items" role="list" style="border-top: 1px solid var(--hairline)">
          {%- for item in cart.items -%}
            {% render 'cart-line', item: item, index: forloop.index, section: section %}
          {%- endfor -%}
        </ul>
      </div>
      <form action="{{ routes.cart_url }}" method="post" class="cart-summary">
        {% render 'shipping-meter' %}
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-note" style="display:flex;justify-content:space-between">
            <span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}
        <div class="cart-totals">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="cart-note">{{ 'cart.taxes_note' | t }}</p>
        {%- if settings.cart_show_note -%}
          <div class="field">
            <label for="CartNote">{{ 'cart.note' | t }}</label>
            <textarea class="textarea" id="CartNote" name="note">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
        <button type="submit" name="checkout" class="btn btn--primary btn--block btn--lg">
          {% render 'icon', name: 'lock' %}{{ 'cart.checkout' | t }}
        </button>
        {%- if additional_checkout_buttons -%}
          <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
      </form>
    </div>
  {%- else -%}
    <div class="cart-empty">
      <p class="h3">{{ 'cart.empty' | t }}</p>
      <p class="muted">{{ 'cart.empty_hint' | t }}</p>
      <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "class": "section section--flush-top",
  "settings": []
}
{% endschema %}

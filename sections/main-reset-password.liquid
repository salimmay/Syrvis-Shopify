<div class="page-width auth">
  <div class="auth__card">
    <h1 class="h2">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form-grid' -%}
      {%- if form.errors -%}<div class="form-status form-status--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input class="input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetConfirm">{{ 'customer.password_confirm' | t }}</label><input class="input" id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--primary btn--block">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}

<div class="page-width">
  <h1 class="h1" style="padding-block: clamp(32px, 5vw, 56px) 24px">{{ blog.title }}</h1>
  {%- paginate blog.articles by 9 -%}
    <div class="collection-tiles" style="--cols: 3">
      {%- for article in blog.articles -%}
        <a class="collection-tile" href="{{ article.url }}">
          <div class="media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', widths: '400, 600, 900' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <span class="small muted">{{ article.published_at | time_tag: format: 'date' }}</span>
          <span class="collection-tile__title">{{ article.title }}</span>
          {%- if article.excerpt != blank -%}<span class="small muted">{{ article.excerpt | strip_html | truncatewords: 22 }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog posts",
  "class": "section section--flush-top",
  "settings": []
}
{% endschema %}

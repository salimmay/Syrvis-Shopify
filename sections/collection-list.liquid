{%- liquid
  assign s = section.settings
  assign count = section.blocks.size
-%}
<section class="section">
  <div class="page-width slider" data-slider style="--per-view: {{ s.columns }}; --per-view-mobile: {{ s.columns_mobile }}">
    <div class="section-head reveal">
      {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
      <div class="slider__controls" data-slider-controls>
        <button type="button" class="slider__btn" data-slider-prev aria-label="{{ 'general.slider.previous' | t }}" disabled>{% render 'icon', name: 'chevron-left' %}</button>
        <button type="button" class="slider__btn" data-slider-next aria-label="{{ 'general.slider.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
    </div>

    <ul class="slider__track" role="list" data-slider-track aria-label="{{ s.heading | escape }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <li class="slider__item reveal" style="--i: {{ forloop.index0 | at_most: 5 }}" {{ block.shopify_attributes }}>
          <a class="collection-tile" href="{% if c != blank %}{{ c.url }}{% else %}#{% endif %}">
            <div class="media">
              {%- assign img = block.settings.image | default: c.featured_image -%}
              {%- if img -%}
                {{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 45vw, 75vw', widths: '300, 450, 600, 900', alt: c.title }}
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="collection-tile__title">
              {{ block.settings.title | default: c.title | default: 'Collection' }}
              <span class="collection-tile__arrow">{% render 'icon', name: 'chevron-right' %}</span>
            </span>
            {%- if block.settings.subtitle != blank -%}<span class="small muted">{{ block.settings.subtitle }}</span>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if count > s.columns -%}
      <div class="slider__progress" aria-hidden="true"><span data-slider-progress></span></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by space" },
    { "type": "range", "id": "columns", "label": "Visible on desktop", "min": 2, "max": 5, "step": 1, "default": 3, "info": "Add more collections than this and the row becomes a slider." },
    { "type": "select", "id": "columns_mobile", "label": "Visible on mobile", "options": [ { "value": "1.2", "label": "1 + peek" }, { "value": "2.2", "label": "2 + peek" } ], "default": "1.2" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "e.g. Lamps, stands, cable control" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "presets": [
    { "name": "Collection list", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] }
  ]
}
{% endschema %}

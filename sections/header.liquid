{%- liquid
  assign menu = section.settings.menu
-%}
<header class="site-header">
  <div class="page-width site-header__in">
    <button type="button" class="icon-btn menu-toggle" data-drawer-open="MenuDrawer" aria-controls="MenuDrawer" aria-expanded="false" aria-label="{{ 'header.menu' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>

    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if section.settings.logo -%}
        {%- assign logo_h = section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round -%}
        {{ section.settings.logo | image_url: width: 600 | image_tag: width: section.settings.logo_width, height: logo_h, widths: '150, 300, 450, 600', alt: shop.name, preload: true }}
      {%- else -%}
        <span class="logo-mark" aria-hidden="true"></span>{{ shop.name }}
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="{{ 'header.primary' | t }}">
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="site-nav__item" data-mega>
            <button type="button" class="site-nav__link" aria-expanded="false" aria-controls="Mega-{{ forloop.index }}">
              {{ link.title }}{% render 'icon', name: 'chevron-down' %}
            </button>
            <div class="mega" id="Mega-{{ forloop.index }}">
              <div class="page-width mega__in">
                {%- for child in link.links -%}
                  <div class="mega__col">
                    {%- if child.links.size > 0 -%}
                      <h3><a href="{{ child.url }}">{{ child.title }}</a></h3>
                      <ul role="list">
                        {%- for grandchild in child.links -%}
                          <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      <ul role="list"><li><a href="{{ child.url }}">{{ child.title }}</a></li></ul>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
                <div class="mega__col"><ul role="list"><li><a class="link-arrow" href="{{ link.url }}">{{ 'header.shop_all' | t: title: link.title }} ›</a></li></ul></div>
                {%- for block in section.blocks -%}
                  {%- assign target = block.settings.menu_item | downcase | strip -%}
                  {%- assign current = link.title | downcase | strip -%}
                  {%- if target == current -%}
                    <a class="mega__feature" href="{{ block.settings.link | default: link.url }}" {{ block.shopify_attributes }}>
                      {%- if block.settings.image -%}
                        {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '300px', widths: '300, 600', alt: '' }}
                      {%- endif -%}
                      <span>{{ block.settings.heading }}</span>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- else -%}
          <div class="site-nav__item">
            <a class="site-nav__link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="site-header__actions">
      <a class="icon-btn" href="{{ routes.search_url }}" data-search-open aria-label="{{ 'search.title' | t }}">
        {% render 'icon', name: 'search' %}
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{{ 'header.account' | t }}">
          {% render 'icon', name: 'user' %}
        </a>
      {%- endif -%}
      <a class="icon-btn" href="{{ routes.cart_url }}"{% if settings.cart_type == 'drawer' %} data-drawer-open="CartDrawer" aria-controls="CartDrawer" aria-expanded="false"{% endif %} aria-label="{{ 'header.cart' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count aria-live="polite"{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div id="MenuDrawer" class="drawer drawer--left" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'header.menu' | t }}">
  <div class="drawer__scrim" data-drawer-close></div>
  <div class="drawer__panel">
    <div class="drawer__head">
      <span class="logo"><span class="logo-mark" aria-hidden="true"></span>{{ shop.name }}</span>
      <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__body">
      <ul class="mobile-nav" role="list">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details>
                <summary>{{ link.title }}{% render 'icon', name: 'chevron-down' %}</summary>
                <ul role="list">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                  {%- endfor -%}
                  <li><a href="{{ link.url }}">{{ 'header.shop_all' | t: title: link.title }}</a></li>
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}">{{ link.title }}{% render 'icon', name: 'chevron-right' %}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="drawer__foot">
      {%- if shop.customer_accounts_enabled -%}
        <a class="btn btn--secondary btn--block" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
          {%- if customer -%}{{ 'header.account' | t }}{%- else -%}{{ 'customer.login.title' | t }}{%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "max_blocks": 6,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 240, "step": 10, "unit": "px", "default": 130 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Menu items with sub-items open as a mega menu. Add a third level for grouped columns." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Mega menu image",
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Menu item", "info": "Exact title of the top-level menu item, e.g. Smart Home" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}

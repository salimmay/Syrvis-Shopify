{%- liquid
  assign s = section.settings
  assign layout = s.layout
  assign heading_tag = 'h2'
  if section.index == 1
    assign heading_tag = 'h1'
  endif
  assign trust_items = s.trust | split: '|'
-%}

{%- capture ctas -%}
  <div class="hero__ctas rise" style="--i: 3">
    {%- if s.button_label != blank -%}
      <a class="btn btn--primary btn--lg" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a>
    {%- endif -%}
    {%- if s.button2_label != blank -%}
      <a class="btn btn--ghost btn--lg" href="{{ s.button2_link | default: routes.collections_url }}">{{ s.button2_label }} ›</a>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- capture trust -%}
  {%- if trust_items.size > 0 and s.trust != blank -%}
    <ul class="hero__trust rise" style="--i: 5" role="list">
      {%- for t in trust_items -%}<li>{{ t | strip }}</li>{%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}

<section class="hero hero--{{ layout }}">
  <div class="page-width">
    {%- case layout -%}

      {%- when 'stage' -%}
        {%- if s.eyebrow != blank -%}<p class="eyebrow rise">{{ s.eyebrow }}</p>{%- endif -%}
        <{{ heading_tag }} class="display rise" style="--i: 1">{{ s.heading | newline_to_br }}</{{ heading_tag }}>
        {%- if s.text != blank -%}<p class="lead rise" style="--i: 2">{{ s.text }}</p>{%- endif -%}
        {{ ctas }}
        <div class="media hero__stage-media settle{% if s.image_fit == 'cover' %} has-cover{% endif %}">
          {%- if s.image -%}
            {{ s.image | image_url: width: 2160 | image_tag: sizes: '(min-width: 1100px) 1080px, 100vw', widths: '540, 720, 1080, 1440, 2160', preload: true, fetchpriority: 'high' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if s.chips_menu.links.size > 0 -%}
          <div class="hero__chips rise" style="--i: 4">
            {%- for link in s.chips_menu.links limit: 6 -%}<a class="chip" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
          </div>
        {%- endif -%}
        {{ trust }}

      {%- when 'split' -%}
        <div class="hero__grid">
          <div>
            {%- if s.eyebrow != blank -%}<p class="eyebrow rise">{{ s.eyebrow }}</p>{%- endif -%}
            <{{ heading_tag }} class="display rise" style="--i: 1">{{ s.heading | newline_to_br }}</{{ heading_tag }}>
            {%- if s.text != blank -%}<p class="lead rise" style="--i: 2">{{ s.text }}</p>{%- endif -%}
            {{ ctas }}
            {{ trust }}
          </div>
          <div class="hero__tiles">
            {%- if s.collection != blank and s.collection.products_count > 0 -%}
              {%- for product in s.collection.products limit: 4 -%}
                <a class="hero__tile rise" style="--i: {{ forloop.index }}" href="{{ product.url }}">
                  <div class="media" style="--ratio: 1" data-product-handle="{{ product.handle }}">
                    {%- if product.featured_media -%}
                      {%- assign tile_alt = product.featured_media.alt | default: product.title -%}
                      {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'eager', sizes: '(min-width: 860px) 25vw, 50vw', widths: '300, 450, 600', alt: tile_alt }}
                    {%- endif -%}
                  </div>
                  <span class="hero__tile-name">{{ product.title }}</span>
                  {% render 'price', product: product %}
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <div class="hero__tile rise" style="--i: {{ i }}">
                  <div class="media" style="--ratio: 1">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
                  <span class="hero__tile-name">{{ 'products.card.placeholder_title' | t }}</span>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

      {%- when 'bento' -%}
        <div class="hero__bento-head">
          <div>
            {%- if s.eyebrow != blank -%}<p class="eyebrow rise">{{ s.eyebrow }}</p>{%- endif -%}
            <{{ heading_tag }} class="display rise" style="--i: 1">{{ s.heading | newline_to_br }}</{{ heading_tag }}>
          </div>
          {%- if s.text != blank -%}<p class="lead rise" style="--i: 2">{{ s.text }}</p>{%- endif -%}
        </div>
        <div class="bento">
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings
              assign size = ''
              if forloop.index == 1
                assign size = 'bento__cell--lg'
              elsif forloop.index == 2
                assign size = 'bento__cell--wide'
              endif
            -%}
            <a class="bento__cell {{ size }}{% if b.image_fit == 'cover' %} bento__cell--cover{% endif %} rise"
               href="{{ b.link | default: '#' }}"
               style="--i: {{ forloop.index }}; --cell-bg: {{ b.background }}; --cell-ink: {{ b.text_color }};{% if b.link_color != blank %} --cell-link: {{ b.link_color }};{% endif %}"
               {{ block.shopify_attributes }}>
              <div>
                {%- if b.kicker != blank -%}<p>{{ b.kicker }}</p>{%- endif -%}
                {%- if b.big_text != blank -%}<div class="bento__big">{{ b.big_text }}</div>{%- endif -%}
                {%- if b.heading != blank -%}<h3>{{ b.heading }}</h3>{%- endif -%}
                {%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}
              </div>
              {%- if b.link_label != blank -%}<span class="link-arrow">{{ b.link_label }} ›</span>{%- endif -%}
              {%- if b.image -%}
                <span class="bento__img">
                  {{ b.image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width: 860px) 50vw, 100vw', widths: '400, 600, 900, 1200', alt: '' }}
                </span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
        <div style="margin-top: 22px">{{ trust }}</div>
    {%- endcase -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stage", "label": "Stage — one big product moment" },
        { "value": "split", "label": "Split — headline + 4 products" },
        { "value": "bento", "label": "Bento — category tiles" }
      ],
      "default": "split"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Smart home · Desk · Phone" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Tech that fits your space." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Curated gadgets that make your home, desk and phone work better — without the clutter." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop best sellers" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button label", "default": "See today's deals" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },
    { "type": "text", "id": "trust", "label": "Trust points", "info": "Separate with |", "default": "Free shipping to US & EU over $49 | 30-day returns | Secure checkout" },
    { "type": "header", "content": "Stage layout" },
    { "type": "image_picker", "id": "image", "label": "Stage image", "info": "A transparent PNG of your hero product(s) works best, 2160 × 945px." },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [ { "value": "contain", "label": "Product on stage" }, { "value": "cover", "label": "Full-bleed photo" } ], "default": "contain" },
    { "type": "link_list", "id": "chips_menu", "label": "Category chips menu" },
    { "type": "header", "content": "Split layout" },
    { "type": "collection", "id": "collection", "label": "Products to show", "info": "First 4 products are shown." },
    { "type": "header", "content": "Bento layout" },
    { "type": "paragraph", "content": "Add tile blocks. Tile 1 is large, tile 2 is wide." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Bento tile",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Small label" },
        { "type": "text", "id": "big_text", "label": "Big text", "info": "e.g. −25%" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Smart Home" },
        { "type": "text", "id": "text", "label": "Text", "default": "Hubs, lights, cameras, plugs" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "image_fit", "label": "Image style", "options": [ { "value": "product", "label": "Product cut-out" }, { "value": "cover", "label": "Full background" } ], "default": "product" },
        { "type": "color", "id": "background", "label": "Background", "default": "#eef1ff" },
        { "type": "color", "id": "text_color", "label": "Text", "default": "#1d1d1f" },
        { "type": "color", "id": "link_color", "label": "Link color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "tile", "settings": { "heading": "Smart Home", "text": "Hubs, lights, cameras, plugs", "link_label": "Shop Smart Home", "background": "#eef1ff" } },
        { "type": "tile", "settings": { "heading": "Desk Setup", "text": "Lamps, stands, cable control", "link_label": "Shop Desk", "background": "#f3f1ec" } },
        { "type": "tile", "settings": { "heading": "Phone", "text": "Chargers & mounts", "link_label": "Shop", "background": "#eaf6f1" } },
        { "type": "tile", "settings": { "kicker": "This week", "big_text": "−25%", "heading": "", "text": "", "link_label": "Security cams", "background": "#1d1d1f", "text_color": "#ffffff", "link_color": "#9fb3ff" } }
      ]
    }
  ]
}
{% endschema %}

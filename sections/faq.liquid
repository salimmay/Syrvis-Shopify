<section class="section">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2 reveal" style="margin-bottom: 24px">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="accordion reveal">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="plus" aria-hidden="true"></span></summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" } ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most orders arrive in 7–12 business days to the US and Europe. You'll get a tracking link as soon as your order ships.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How long does shipping take?", "answer": "<p>Most orders arrive in 7–12 business days to the US and Europe. You'll get a tracking link as soon as your order ships.</p>" } },
        { "type": "question", "settings": { "question": "Can I return a product?", "answer": "<p>Yes — you have 30 days from delivery to return any item in its original condition.</p>" } },
        { "type": "question", "settings": { "question": "Will it work with my phone / smart home system?", "answer": "<p>Each product page lists compatibility in the specs table. Not sure? Message us before you buy.</p>" } }
      ]
    }
  ]
}
{% endschema %}

<section class="section">
  <div class="page-width">
    <div class="newsletter reveal">
      <div class="stack" style="--stack: 10px">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- form 'customer', id: 'NewsletterForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="newsletter__form">
            <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.label' | t }}</label>
            <input class="input" id="NewsletterEmail" type="email" name="contact[email]" autocomplete="email" inputmode="email" required placeholder="{{ 'newsletter.placeholder' | t }}">
            <button type="submit" class="btn btn--primary">{{ 'newsletter.button' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="form-status form-status--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "text", "id": "text", "label": "Text", "default": "New gadgets, setup ideas and member-only deals. No spam." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}

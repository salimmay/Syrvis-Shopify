{%- liquid
  assign s = section.settings
  assign collection = s.collection
  assign limit = s.limit
-%}
<section class="section">
  <div class="page-width">
    <div class="section-head reveal">
      <div class="stack" style="--stack: 8px">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ s.heading }}</h2>
      </div>
      {%- if collection != blank and s.show_view_all -%}
        <a class="link-arrow" href="{{ collection.url }}">{{ 'general.view_all' | t }} ›</a>
      {%- endif -%}
    </div>

    <ul class="{% if s.mobile_scroll %}product-grid product-grid--scroll{% else %}product-grid{% endif %}" role="list" style="--cols: {{ s.columns }}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <li>{% render 'product-card', product: product, index: forloop.index0, reveal: true %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <li>{% render 'product-card', product: blank, index: forloop.index0, reveal: true %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{%- if s.mobile_scroll -%}
<style>
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .product-grid--scroll { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 72%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding: 4px var(--gutter) 12px; scroll-padding-inline: var(--gutter); }
    #shopify-section-{{ section.id }} .product-grid--scroll > li { scroll-snap-align: start; }
    #shopify-section-{{ section.id }} .product-grid--scroll::-webkit-scrollbar { display: none; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true },
    { "type": "checkbox", "id": "mobile_scroll", "label": "Swipe row on mobile", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}

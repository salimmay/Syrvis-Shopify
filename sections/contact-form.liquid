<div class="page-width page-width--narrow">
  {%- if section.settings.heading != blank -%}<h2 class="h2" style="margin-bottom: 20px">{{ section.settings.heading }}</h2>{%- endif -%}
  {%- form 'contact', class: 'form-grid' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-status form-status--success" role="status">{{ 'contact.success' | t }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="form-grid form-grid--2">
      <div class="field"><label for="ContactName">{{ 'contact.name' | t }}</label><input class="input" id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
      <div class="field"><label for="ContactEmail">{{ 'contact.email' | t }}</label><input class="input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
    </div>
    <div class="field"><label for="ContactOrder">{{ 'contact.order' | t }}</label><input class="input" id="ContactOrder" name="contact[order_number]"></div>
    <div class="field"><label for="ContactBody">{{ 'contact.message' | t }}</label><textarea class="textarea" id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea></div>
    <div><button type="submit" class="btn btn--primary">{{ 'contact.send' | t }}</button></div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "class": "section",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" } ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}

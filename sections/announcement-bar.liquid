{%- if section.settings.text != blank -%}
  <div class="announcement">
    <div class="page-width announcement__in">
      <span>{{ section.settings.text }}</span>
      {%- if section.settings.link != blank and section.settings.link_label != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.link_label }} ›</a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping to the US & EU on orders over $49" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}

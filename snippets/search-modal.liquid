<div id="SearchModal" class="search-modal" role="dialog" aria-modal="true" aria-label="{{ 'search.title' | t }}" aria-hidden="true">
  <div class="search-modal__scrim" data-search-close></div>
  <div class="search-modal__panel">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
      {% render 'icon', name: 'search' %}
      <label class="visually-hidden" for="SearchModalInput">{{ 'search.label' | t }}</label>
      <input
        id="SearchModalInput"
        type="search"
        name="q"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="PredictiveResults"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="button" class="icon-btn" data-search-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </form>
    <div class="search-modal__results" id="PredictiveResults" data-predictive-results>
      {%- assign quick_links = linklists['main-menu'].links -%}
      {%- if quick_links.size > 0 -%}
        <p class="predictive-heading">{{ 'search.popular' | t }}</p>
        <div class="predictive-links">
          {%- for link in quick_links limit: 6 -%}
            <a class="chip" href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
